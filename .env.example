# ============================================================
# Pitch Arena — Production Environment Variables Template
# Copy this file to .env and fill in actual credentials.
# NEVER commit actual secret keys to version control.
# ============================================================

# ── Supabase (Database & Realtime Auth) ───────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Super Admin Email (Single Master Admin) ───────────────────
# The designated super admin email with permanent master control.
# This Super Admin can add and revoke other admin emails directly from the Admin Panel.
VITE_SUPER_ADMIN_EMAIL=admin@yourinstitution.edu

# ── Razorpay Gateway & Static QR Configuration ────────────────
# Your Razorpay Key ID (public key)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Static QR code configuration:
# 1. VITE_MERCHANT_UPI_VPA: The UPI VPA linked to your Razorpay static QR (e.g. sphinx.ecell@okhdfcbank or merchant@razorpay)
VITE_MERCHANT_UPI_VPA=thebigpitchvedn664812.rzp@rxairtel
# 2. VITE_MERCHANT_NAME: Display name shown on attendee UPI app
VITE_MERCHANT_NAME=The Big Pitch Ved Narasalagi
# 3. VITE_STATIC_QR_URL: (Optional) Direct URL/path to static QR image file if you prefer displaying an exact image
VITE_STATIC_QR_URL=

# ── Application URL ──────────────────────────────────────────
# Public URL for OAuth redirects (Supabase Auth Google provider)
VITE_APP_URL=http://localhost:5173

NODE_ENV=development

# ── Supabase Edge Function Secrets (Server-Side Only) ────────
# Set these in: Supabase Dashboard → Edge Functions → Secrets
# NEVER expose these in frontend VITE_ variables!
#
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_SECRET_KEY=your_razorpay_secret_key
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
