# Pitch Arena — Production Environment Configuration
VITE_APP_URL=http://localhost:5173

# Supabase Credentials (Required for real auth and database storage)
# Find these in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Primary Super Admin Email (Single master admin with permanent privileges)
# The Super Admin can add/revoke other admins from the Admin Panel
VITE_SUPER_ADMIN_EMAIL=

# Razorpay Key ID (Public key for checkout popup)
# Find in: Razorpay Dashboard -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=

NODE_ENV=development
